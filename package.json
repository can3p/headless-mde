{
  "name": "@can3p/headless-mde",
  "type": "module",
  "version": "0.0.8",
  "description": "UI headless React markdown editor using only textarea",
  "homepage": "https://github.com/can3p/headless-mde",
  "repository": {
    "type": "git",
    "url": "https://github.com/can3p/headless-mde"
  },
  "author": "Resetand / can3p",
  "license": "MIT",
  "keywords": [
    "react",
    "textarea",
    "markdown",
    "editor",
    "formatting",
    "shortcuts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    }
  },
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "warn"
    }
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "dompurify": "3.4.18",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "marked": "18.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.21.0"
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 . --fix",
    "build": "tsc",
    "test": "jest --colors",
    "test:coverage": "npm run test -- --coverage",
    "test:browser": "playwright test",
    "build:site": "node site/build.ts",
    "start-site": "node site/build.ts --serve 4174",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "prepublish": "npm run lint && npm run test -- --watchAll=false && npm run build",
    "start-sandbox": "npm run build; npm --prefix sandbox i -f; npm link sandbox/node_modules/react; npm --prefix sandbox run start",
    "prepare": "tsc"
  }
}
